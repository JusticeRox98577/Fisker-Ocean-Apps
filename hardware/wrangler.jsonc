// Ocean Live Hardware: the Nova beta tester sign-up at hardware.oceanlive.org.
// Its own Worker and database, so sign-ups are kept apart from the mailing list and the app server.
{
  "name": "ocean-live-hardware",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hardware.oceanlive.org", "custom_domain": true }],

  // The page (public/) is served as static files; /api/* always runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // The answers. The id stays a placeholder here: the Cloudflare build fills it in from the build
  // variable HARDWARE_D1_ID (scripts/fill-ids.mjs).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocean-live-hardware",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Nova release files: firmware images, the Nova app APK, Android OTAs (src/releases.ts).
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "nova-releases" }],

  // Every day at 03:41 UTC: delete expired spam counters, sign-in links and sessions.
  "triggers": { "crons": ["41 3 * * *"] },

  // Emails go out through the mail Worker (mail/src/notify.ts), which has the Resend key.
  "services": [{ "binding": "MAIL", "service": "ocean-live-mail", "entrypoint": "Notify" }],

  "vars": {
    // The only address that can sign in to /admin: sign-in links are emailed here and nowhere else.
    "ADMIN_EMAIL": "justice@oceanlive.org",
    // Sender of the sign-in links and the "you've been picked" emails: a mailbox in the mail Worker.
    // Copies land in its Sent folder.
    "MAIL_FROM": "justice@oceanlive.org",
    // This site, for the links in those emails.
    "SITE_URL": "https://hardware.oceanlive.org",
    // How many test boards there are. Open invitations plus acceptances can't go above this.
    "BOARDS": "4",
    // Sign-ups allowed per network (hashed IP) per hour, to slow down spam.
    "PER_IP_PER_HOUR": "5",
    // Set to "true" to close the form: the page then says sign-ups are closed and the API refuses new ones.
    "CLOSED": "false",
    // The Nova owner PUBLIC key (owner.pub, 64 hex digits): checks developer certificates registered in
    // /admin. Empty until set. The lease key is a secret: wrangler secret put LEASE_KEY (contents of lease.key).
    "OWNER_PUB": "5806f2f124722108f79aefcabd7ff3d9e53753db8f7ae249e177ae2d377ec265",
    // Seconds the public counters (/api/stats) are reused.
    "STATS_CACHE_SECONDS": "60"
  }
}
