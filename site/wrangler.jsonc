{
  // Ocean Live website: static files only, no Worker script.
  "name": "ocean-live-site",
  "compatibility_date": "2026-11-01",
  // workers.dev stays on so CI can read the live downloads (oceanlive.org's bot protection blocks GitHub's runners).
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "oceanlive.org", "custom_domain": true },
    { "pattern": "www.oceanlive.org", "custom_domain": true }
  ]
}
