{
  // Ocean Live website: static files, plus src/worker.js for /api/* (the mailing list and roadmap proxies) and /community*.
  "name": "ocean-live-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // workers.dev stays on so CI can read the live downloads (oceanlive.org's bot protection blocks GitHub's runners).
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only /api/* and the community notes pages (filled in from the app server) reach the script;
    // every other path is served from public/ without it.
    "run_worker_first": ["/api/*", "/community", "/community/*", "/community.html"]
  },
  // The mailing list lives in the mail Worker (mail/). Apply its migration and deploy it before
  // pushing site changes to main (a push deploys the site).
  // The public roadmap (/api/roadmap) comes from the app server (ask-proxy/, ocean-live-ask):
  // deploy it with its /roadmap endpoint before pushing site changes that use it.
  "services": [
    { "binding": "MAIL", "service": "ocean-live-mail" },
    { "binding": "ASK", "service": "ocean-live-ask" }
  ],
  "routes": [
    { "pattern": "oceanlive.org", "custom_domain": true },
    { "pattern": "www.oceanlive.org", "custom_domain": true }
  ]
}
