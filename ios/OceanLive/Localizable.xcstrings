          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído del coche por Ocean Live (no oficial). Los valores son medidos, no un diagnóstico del concesionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
