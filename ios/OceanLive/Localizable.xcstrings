    "Under 60 mV is normal. A spread that keeps growing over weeks is worth a dealer check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter 60 mV ist normal. Wächst die Abweichung über Wochen weiter, lohnt sich ein Check beim Händler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 60 mV es normal. Si la diferencia sigue creciendo durante semanas, merece una revisión en el concesionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de 60 mV est normal. Un écart qui ne cesse d’augmenter sur plusieurs semaines mérite un contrôle chez le concessionnaire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder 60 mV is normaal. Een spreiding die wekenlang blijft groeien, is een controle bij de dealer waard."
          }
        }
      }
    },
