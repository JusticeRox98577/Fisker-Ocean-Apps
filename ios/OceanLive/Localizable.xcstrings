    "Ocean Live 3.3 · unofficial community app. It only reads from the car, except when you clear fault codes or restart a module from the Faults tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocean Live 3.3 · inoffizielle Community-App. Sie liest nur aus dem Auto, außer wenn du im Tab Fehler Fehlercodes löschst oder ein Steuergerät neu startest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocean Live 3.3 · app no oficial de la comunidad. Solo lee del coche, salvo cuando borras códigos de avería o reinicias un módulo desde la pestaña Averías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocean Live 3.3 · app communautaire non officielle. Elle ne fait que lire la voiture, sauf quand vous effacez des codes défaut ou redémarrez un module depuis l’onglet Défauts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocean Live 3.3 · onofficiële community-app. Hij leest alleen uit de auto, behalve als je in het tabblad Storingen foutcodes wist of een module herstart."
          }
        }
      }
    },
