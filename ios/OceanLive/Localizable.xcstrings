    "Reads stored fault codes from %lld modules in the car. Reading changes nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest gespeicherte Fehlercodes aus %lld Steuergeräten im Auto. Lesen ändert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los códigos de avería guardados en %lld módulos del coche. Leer no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les codes défaut mémorisés dans %lld modules de la voiture. La lecture ne modifie rien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest opgeslagen foutcodes uit %lld modules in de auto. Lezen verandert niets."
          }
        }
      }
    },
    "Reads the software version and part number of each module that answered. Reading changes nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Softwareversion und Teilenummer jedes Steuergeräts, das geantwortet hat. Lesen ändert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la versión de software y el número de pieza de cada módulo que respondió. Leer no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la version logicielle et la référence de chaque module qui a répondu. La lecture ne modifie rien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de softwareversie en het onderdeelnummer van elke module die antwoordde. Lezen verandert niets."
          }
        }
      }
    },
