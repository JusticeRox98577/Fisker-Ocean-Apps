    "Shows what each charge cost in Trips, using these prices. Leave a price empty to hide costs for that kind of charge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt unter Fahrten, was jeder Ladevorgang mit diesen Preisen gekostet hat. Lass einen Preis leer, um die Kosten für diese Art Ladung auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en Viajes cuánto costó cada carga con estos precios. Deja un precio vacío para ocultar los costes de ese tipo de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche dans Trajets le coût de chaque recharge avec ces prix. Laissez un prix vide pour masquer les coûts de ce type de recharge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont in Ritten wat elke laadbeurt kostte, met deze prijzen. Laat een prijs leeg om kosten voor dat soort laden te verbergen."
          }
        }
      }
    },
    "Since the scan on %@: %lld new, %lld cleared": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit dem Scan am %1$@: %2$lld neu, %3$lld gelöscht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el escaneo del %1$@: %2$lld nuevos, %3$lld borrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis l’analyse du %1$@ : %2$lld nouveaux, %3$lld effacés"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinds de scan op %1$@: %2$lld nieuw, %3$lld gewist"
          }
        }
      }
    },
