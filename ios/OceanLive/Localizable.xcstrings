    "Published usable capacity: 106.5 kWh for One, Extreme and Ultra, about 75 kWh for the Sport. Used for range and charge-time estimates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veröffentlichte nutzbare Kapazität: 106,5 kWh für One, Extreme und Ultra, etwa 75 kWh für den Sport. Wird für Reichweite und Ladezeit-Schätzungen genutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacidad útil publicada: 106,5 kWh para One, Extreme y Ultra, unos 75 kWh para el Sport. Se usa para estimar la autonomía y el tiempo de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacité utile publiée : 106,5 kWh pour One, Extreme et Ultra, environ 75 kWh pour la Sport. Sert aux estimations d’autonomie et de temps de recharge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepubliceerde bruikbare capaciteit: 106,5 kWh voor One, Extreme en Ultra, ongeveer 75 kWh voor de Sport. Gebruikt voor schattingen van bereik en laadtijd."
          }
        }
      }
    },
