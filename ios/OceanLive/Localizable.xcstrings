    "Lost the adapter. Ocean Live stopped trying so the car can sleep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapter verloren. Ocean Live versucht es nicht weiter, damit das Auto schlafen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió el adaptador. Ocean Live dejó de intentarlo para que el coche pueda dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptateur perdu. Ocean Live a cessé d’essayer pour que la voiture puisse dormir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapter kwijt. Ocean Live is gestopt met proberen zodat de auto kan slapen."
          }
        }
      }
    },
