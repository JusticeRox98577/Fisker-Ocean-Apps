    "Alerts work while the app is open or connected in the background. iPhone may pause the connection when the app has been in the background for a long time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen funktionieren, solange die App offen oder im Hintergrund verbunden ist. Das iPhone kann die Verbindung pausieren, wenn die App lange im Hintergrund war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos funcionan con la app abierta o conectada en segundo plano. El iPhone puede pausar la conexión si la app lleva mucho tiempo en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes fonctionnent quand l’app est ouverte ou connectée en arrière-plan. L’iPhone peut suspendre la connexion si l’app reste longtemps en arrière-plan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen werken als de app open is of op de achtergrond verbonden is. iPhone kan de verbinding pauzeren als de app lang op de achtergrond staat."
          }
        }
      }
    },
