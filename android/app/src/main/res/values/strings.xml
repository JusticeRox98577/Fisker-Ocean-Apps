    <string name="settings_watch_keep">Keep the adapter connected</string>
    <string name="settings_watch_keep_note">Use this only if your adapter can\'t be woken over Bluetooth. The adapter stays awake and uses about 50 mA (around 1.2 Ah a day).</string>
