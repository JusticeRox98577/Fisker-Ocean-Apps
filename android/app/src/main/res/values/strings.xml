    <string name="ask_new_chat">New chat</string>
    <string name="ask_intro">Ask about your Fisker Ocean or Ocean Live. Answers come from Claude, an AI by Anthropic, using an Ocean guide and a fault code table.</string>
    <string name="ask_share_car">Include my car\'s readings</string>
    <string name="ask_share_car_on">Your latest readings and fault codes go with each question, never your VIN or location. Asking never wakes the car.</string>
    <string name="ask_share_car_off">Only your question is sent.</string>
    <string name="ask_show_sent">Show what\'s sent</string>
    <string name="ask_hide_sent">Hide</string>
    <string name="ask_example_1">What does my 12V voltage mean?</string>
    <string name="ask_example_2">Is my cell spread normal?</string>
    <string name="ask_example_3">Which fault codes should worry me?</string>
    <string name="ask_placeholder">Ask a question</string>
    <string name="ask_send">Send</string>
    <string name="ask_thinking">Thinking…</string>
    <string name="ask_disclaimer">AI answers can be wrong. Check anything important with a qualified EV shop. Questions, answers and the readings sent with them go to Ocean Live\'s server and to Anthropic, and Ocean Live keeps them for 90 days for research.</string>
