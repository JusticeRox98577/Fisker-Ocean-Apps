<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Backup is off (allowBackup="false"); this also keeps the settings,
     which hold the ABRP token and key, out of cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ocean_live.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ocean_live.xml" />
    </device-transfer>
</data-extraction-rules>
